PORT=4000
# Generate a real random value — do not use this placeholder:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional — where scripts/backup-db.js writes its daily snapshots. Defaults to server/backups
# (same disk as shop.db itself) if unset. Point this at a folder synced by OneDrive, Google
# Drive, etc. so a backup actually survives this machine failing. Never a path under this repo,
# and never a GitHub remote — this app stores real customer PII, and this repo is public.
# BACKUP_DIR=
