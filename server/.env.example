PORT=4000
# Generate a real random value — do not use this placeholder:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional — where scripts/backup-db.js writes its daily snapshots. Defaults to server/backups
# (same disk as shop.db itself) if unset. Point this at a folder synced by OneDrive, Google
# Drive, etc. so a backup actually survives this machine failing. Never a path under this repo,
# and never a GitHub remote — this app stores real customer PII, and this repo is public.
# BACKUP_DIR=

# Optional — only needed to override where the HTTPS cert/key live. Without either of these,
# the server looks for server/certs/cert.pem and server/certs/key.pem; if neither exists it
# falls back to plain HTTP (this is what local `npm run dev` uses). See README for how to
# generate a self-signed cert for the shop's LAN.
# HTTPS_CERT=
# HTTPS_KEY=
